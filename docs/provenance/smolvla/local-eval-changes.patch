+def _save_task_trajectory_plot(task_info: dict[str, Any], traces: list[dict[str, Any]], path: Path) -> None:
+    """Plot per-step reward and success statistics across a task's episodes."""
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    if not traces:
+        return
+
+    def as_matrix(key: str) -> np.ndarray:
+        max_steps = max(len(trace[key]) for trace in traces)
+        values = np.full((len(traces), max_steps), np.nan, dtype=float)
+        for row, trace in enumerate(traces):
+            values[row, : len(trace[key])] = trace[key]
+        return values
+
+    rewards = as_matrix("reward")
+    # An episode's only true ``success`` value is its terminal transition.  Do
+    # not average that pulse directly: a successfully finished episode has no
+    # later entries, so it would disappear from the denominator and make the
+    # curve fall back to zero.  Latch success and extend it to the common
+    # horizon, yielding the intuitive fraction of all episodes that have
+    # succeeded by each step.
+    successes = np.zeros_like(rewards)
+    for row, trace in enumerate(traces):
+        n_steps = len(trace["success"])
+        cumulative_success = np.maximum.accumulate(np.asarray(trace["success"], dtype=bool))
+        successes[row, :n_steps] = cumulative_success
+        if n_steps < successes.shape[1] and cumulative_success[-1]:
+            successes[row, n_steps:] = True
+    steps = np.arange(rewards.shape[1])
+    final_successes = [bool(np.any(trace["success"])) for trace in traces]
+    success_rate = 100 * float(np.mean(final_successes))
+
+    figure, axes = plt.subplots(2, 1, sharex=True, figsize=(9, 6), constrained_layout=True)
+    for axis, values, label in (
+        (axes[0], rewards, "Reward"),
+        (axes[1], successes, "Cumulative success rate"),
+    ):
+        mean = np.nanmean(values, axis=0)
+        std = np.nanstd(values, axis=0)
+        axis.plot(steps, mean, color="#1f77b4", linewidth=2, label="mean")
+        axis.fill_between(steps, mean - std, mean + std, color="#1f77b4", alpha=0.22, label="±1 std")
+        axis.set_ylabel(label)
+        axis.grid(alpha=0.25)
+        axis.legend(loc="best")
+
+    axes[1].set_xlabel("Environment step")
+    description = textwrap.fill(task_info["task_description"], width=80)
+    figure.suptitle(
+        f"{task_info['task_group']} task {task_info['task_id']} | "
+        f"{len(traces)} episodes | total success: {success_rate:.1f}%\n{description}",
+        fontsize=10,
+    )
+    path.parent.mkdir(parents=True, exist_ok=True)
+    figure.savefig(path, dpi=160)
+    plt.close(figure)
+
+
+def _save_task_episode_artifacts(
+    task_group: str, task_id: int, metrics: dict[str, Any], output_dir: Path
+) -> None:
+    """Immediately persist one completed task's per-step data and summary plot."""
+    output_dir.mkdir(parents=True, exist_ok=True)
+    traces = metrics.pop("episode_traces")
+    trace_path = output_dir / "episode_traces" / f"{task_group}_{task_id}.json"
+    plots_dir = output_dir / "plots"
+    plot_path = plots_dir / f"{task_group}_{task_id}_trajectory.png"
+    task_info = {
+        "task_group": task_group,
+        "task_id": task_id,
+        "task_description": metrics["task_description"],
+    }
+    trace_path.parent.mkdir(parents=True, exist_ok=True)
+    with open(trace_path, "w") as f:
+        json.dump({**task_info, "episodes": traces}, f, indent=2)
+    _save_task_trajectory_plot(task_info, traces, plot_path)
+    metrics["episode_trace_path"] = str(trace_path)
+    metrics["trajectory_plot_path"] = str(plot_path)
+
