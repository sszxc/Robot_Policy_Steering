<!-- Screwdriver seated in a screw: world-fixed hinge about z; frictionloss/damping stand in for thread friction. -->
<mujoco model="screwdriver">
  <compiler angle="radian" />
  <worldbody>
    <body name="screwdriver">
      <joint name="sd_turn" type="hinge" axis="0 0 1" damping="0.001" frictionloss="0.01" armature="1e-5" />
      <geom name="sd_handle" type="cylinder" size="0.015 0.04" pos="0 0 0.04" mass="0.04" condim="4"
            friction="1.2 0.01 0.001" rgba="0.85 0.15 0.1 1" />
      <geom name="sd_cap" type="cylinder" size="0.013 0.004" pos="0 0 0.082" mass="0.005" rgba="0.1 0.1 0.1 1"
            contype="0" conaffinity="0" />
      <!-- stripe to make rotation visible -->
      <geom name="sd_stripe" type="box" size="0.0035 0.002 0.038" pos="0.0145 0 0.04" rgba="1 0.9 0.2 1"
            contype="0" conaffinity="0" mass="0" />
      <geom name="sd_shaft" type="capsule" fromto="0 0 0 0 0 -0.09" size="0.003" mass="0.02" rgba="0.75 0.75 0.78 1"
            contype="0" conaffinity="0" />
    </body>
  </worldbody>
</mujoco>
