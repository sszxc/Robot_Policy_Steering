<?xml version="1.0"?>
<!-- UR5 on world + table + ceiling camera (placeholder). Dimensions from old ur_table_assembly / ur_mop_standalone. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5"/>
  <xacro:arg name="tf_prefix" default=""/>
  <!-- ur_moveit_config passes *_params args pointing into this package; UR5 yaml is always read from ur_description -->
  <xacro:arg name="joint_limit_params" default=""/>
  <xacro:arg name="kinematics_params" default=""/>
  <xacro:arg name="physical_params" default=""/>
  <xacro:arg name="visual_params" default=""/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="sim_ignition" default="true"/>
  <xacro:arg name="simulation_controllers" default="$(find thesis_scene)/config/controllers.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>

  <xacro:macro name="fixed_inertial">
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </xacro:macro>

  <link name="world"/>

  <xacro:ur_robot
    name="$(arg name)" tf_prefix="$(arg tf_prefix)" parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    transmission_hw_interface="$(arg transmission_hw_interface)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    use_fake_hardware="$(arg use_fake_hardware)"
    sim_ignition="$(arg sim_ignition)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
    robot_ip="$(arg robot_ip)"
    ur_type="$(arg ur_type)">
    <origin xyz="0 0 0.65" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Table: box collision, STL visual -->
  <link name="table_link">
    <xacro:fixed_inertial/>
    <visual>
      <origin xyz="0.7 0.36 -0.3"/>
      <geometry><mesh filename="package://thesis_scene/meshes/table.stl"/></geometry>
      <material name="table_material"><color rgba="0.6 0.4 0.2 1"/></material>
    </visual>
    <collision><geometry><box size="1.38 0.72 0.60"/></geometry></collision>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/><child link="table_link"/>
    <origin xyz="0.0 0.45 0.31"/>
  </joint>

  <!-- Ceiling camera: beam (z=2.17) -> drop pipe -> camera box looking straight down -->
  <xacro:property name="cam_x" value="0.0"/>
  <xacro:property name="cam_y" value="0.635"/>
  <xacro:property name="cam_z" value="1.57"/>

  <link name="camera_beam_link">
    <xacro:fixed_inertial/>
    <visual><geometry><cylinder length="1.23" radius="0.025"/></geometry>
      <material name="pipe_material"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><geometry><cylinder length="1.23" radius="0.025"/></geometry></collision>
  </link>
  <joint name="world_to_beam" type="fixed">
    <parent link="world"/><child link="camera_beam_link"/>
    <origin xyz="${cam_x} ${cam_y - 0.615} 2.17" rpy="${pi/2} 0 0"/>
  </joint>

  <link name="camera_pipe_link">
    <xacro:fixed_inertial/>
    <visual><geometry><cylinder length="0.60" radius="0.025"/></geometry>
      <material name="pipe_material"/></visual>
    <collision><geometry><cylinder length="0.60" radius="0.025"/></geometry></collision>
  </link>
  <joint name="world_to_pipe" type="fixed">
    <parent link="world"/><child link="camera_pipe_link"/>
    <origin xyz="${cam_x} ${cam_y} ${cam_z + 0.3}"/>
  </joint>

  <link name="camera_link">
    <xacro:fixed_inertial/>
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="pipe_material"/></visual>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
  </link>
  <joint name="world_to_camera" type="fixed">
    <parent link="world"/><child link="camera_link"/>
    <origin xyz="${cam_x} ${cam_y} ${cam_z}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="ceiling_camera" type="camera">
      <pose>0 0 -0.05 0 ${pi/2} 0</pose>
      <update_rate>15</update_rate>
      <topic>ceiling_camera/image</topic>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>5</far></clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg sim_ignition)">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <controller_manager_node_name>$(arg tf_prefix)controller_manager</controller_manager_node_name>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
