<!-- Lab UR5 (CB3) + ROBOTIS hand mount, from ros2_ur (pixi_teleop 7dc57cb) xacro: ur_type:=ur5, robot_calibration.yaml
     kinematics, tool:=hand_right, hand_mount_rpy:="0 0 -1.5708" (ur_hand_control.launch.py). Visuals: ur_description
     DAE -> OBJ per material; collision: ur_description collision STLs (convex hulls). Body frames = ROS link frames. -->
<mujoco model="ur5_lab">
  <compiler angle="radian" meshdir="assets" autolimits="true" />

  <option integrator="implicitfast" />

  <default>
    <default class="ur5">
      <material specular="0.5" shininess="0.25" />
      <joint axis="0 0 1" range="-6.28319 6.28319" armature="0.1" actuatorgravcomp="true" />
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="2000" biasprm="0 -2000 -400"
        forcerange="-150 150" />
      <default class="size3_limited">
        <joint range="-3.1415 3.1415" />
        <general ctrlrange="-3.1415 3.1415" />
      </default>
      <!-- gravcomp goes through the actuators (the real UR tracks without sag);
           wrist kv 25 instead of menagerie's 100 (overdamped, lags fast targets) -->
      <default class="size1">
        <general gainprm="500" biasprm="0 -500 -25" forcerange="-28 28" />
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom type="mesh" group="3" />
      </default>
      <site size="0.005" rgba="1 0 0 0.5" group="4" />
    </default>
  </default>

  <asset>
    <material class="ur5" name="black" rgba="0.033 0.033 0.033 1" />
    <material class="ur5" name="jointgray" rgba="0.278 0.278 0.278 1" />
    <material class="ur5" name="linkgray" rgba="0.82 0.82 0.82 1" />
    <material class="ur5" name="urblue" rgba="0.49 0.678 0.8 1" />
    <material name="mount_ring" rgba="0.75 0.75 0.75 1" />
    <material name="mount_black" rgba="0.1 0.1 0.1 1" />

    <mesh file="base_0.obj" />
    <mesh file="base_1.obj" />
    <mesh file="shoulder_0.obj" />
    <mesh file="shoulder_1.obj" />
    <mesh file="shoulder_2.obj" />
    <mesh file="upperarm_0.obj" />
    <mesh file="upperarm_1.obj" />
    <mesh file="upperarm_2.obj" />
    <mesh file="upperarm_3.obj" />
    <mesh file="forearm_0.obj" />
    <mesh file="forearm_1.obj" />
    <mesh file="forearm_2.obj" />
    <mesh file="wrist1_0.obj" />
    <mesh file="wrist1_1.obj" />
    <mesh file="wrist1_2.obj" />
    <mesh file="wrist2_0.obj" />
    <mesh file="wrist2_1.obj" />
    <mesh file="wrist2_2.obj" />
    <mesh file="wrist3_0.obj" />
    <mesh file="wrist3_1.obj" />
    <mesh file="base_col.stl" />
    <mesh file="shoulder_col.stl" />
    <mesh file="upperarm_col.stl" />
    <mesh file="forearm_col.stl" />
    <mesh file="wrist1_col.stl" />
    <mesh file="wrist2_col.stl" />
    <mesh file="wrist3_col.stl" />
    <mesh file="hand_mount.stl" scale="0.001 0.001 0.001" />
  </asset>

  <worldbody>
    <!-- ROS base_link; base_link_inertia (yaw pi) folded into the children below -->
    <body name="base" gravcomp="1" childclass="ur5">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072" />
      <geom mesh="base_0" material="black" class="visual" />
      <geom mesh="base_1" material="linkgray" class="visual" />
      <geom mesh="base_col" class="collision" />
      <body name="shoulder_link" gravcomp="1" pos="0 0 0.0889803557" quat="3.55845487e-05 0 0 0.999999999">
        <inertial mass="3.7" pos="0 -0.00193 -0.02561" diaginertia="0.0149723583 0.0149723583 0.01040625" />
        <joint name="shoulder_pan_joint" />
        <geom mesh="shoulder_0" material="black" class="visual" quat="0 0 0 1" />
        <geom mesh="shoulder_1" material="jointgray" class="visual" quat="0 0 0 1" />
        <geom mesh="shoulder_2" material="urblue" class="visual" quat="0 0 0 1" />
        <geom mesh="shoulder_col" class="collision" quat="0 0 0 1" />
        <body name="upper_arm_link" gravcomp="1" pos="0.000270333786 0 0" quat="0.707374097 0.706839363 -2.20093544e-05 -2.20260048e-05">
          <inertial mass="8.393" pos="-0.2125 0 0.11336" quat="0.707106781 0 0.707106781 0"
            diaginertia="0.133885835 0.133885835 0.0151074" />
          <joint name="shoulder_lift_joint" />
          <geom mesh="upperarm_0" material="black" class="visual" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5" />
          <geom mesh="upperarm_1" material="jointgray" class="visual" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5" />
          <geom mesh="upperarm_2" material="urblue" class="visual" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5" />
          <geom mesh="upperarm_3" material="linkgray" class="visual" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5" />
          <geom mesh="upperarm_col" class="collision" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5" />
          <body name="forearm_link" gravcomp="1" pos="-0.424973593 0 0" quat="0.999999834 0.000284777839 0.000500799845 -1.19638268e-05">
            <inertial mass="2.33" pos="-0.24225 0 0.0265" quat="0.707106781 0 0.707106781 0"
              diaginertia="0.0312168035 0.0312168035 0.004095" />
            <joint name="elbow_joint" class="size3_limited" />
            <geom mesh="forearm_0" material="jointgray" class="visual" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5" />
            <geom mesh="forearm_1" material="urblue" class="visual" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5" />
            <geom mesh="forearm_2" material="linkgray" class="visual" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5" />
            <geom mesh="forearm_col" class="collision" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5" />
            <body name="wrist_1_link" gravcomp="1" pos="-0.392058319 -0.000652025215 0.110897593"
              quat="0.999995313 0.00293972654 0.000855901253 -6.0546712e-06">
              <inertial mass="1.219" pos="0 -0.01634 -0.0018" diaginertia="0.00201388958 0.00201388958 0.0021942" />
              <joint name="wrist_1_joint" class="size1" />
              <geom mesh="wrist1_0" material="black" class="visual" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0" />
              <geom mesh="wrist1_1" material="jointgray" class="visual" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0" />
              <geom mesh="wrist1_2" material="urblue" class="visual" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0" />
              <geom mesh="wrist1_col" class="collision" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0" />
              <body name="wrist_2_link" gravcomp="1" pos="-3.76460247e-05 -0.0947510275 -4.15499583e-05"
                quat="0.706951725 0.707261803 -2.65656148e-06 -2.65539679e-06">
                <inertial mass="1.219" pos="0 0.01634 -0.0018" diaginertia="0.00183103958 0.00183103958 0.0021942" />
                <joint name="wrist_2_joint" class="size1" />
                <geom mesh="wrist2_0" material="black" class="visual" pos="0 0 -0.095" />
                <geom mesh="wrist2_1" material="jointgray" class="visual" pos="0 0 -0.095" />
                <geom mesh="wrist2_2" material="urblue" class="visual" pos="0 0 -0.095" />
                <geom mesh="wrist2_col" class="collision" pos="0 0 -0.095" />
                <!-- wrist_3_link frame == ROS tool0 (flange and tool0 rotations cancel) -->
                <body name="wrist_3_link" gravcomp="1" pos="-1.01300069e-05 0.0825554758 2.92780767e-05"
                  quat="0.707232156 -0.706981383 2.42339734e-05 -2.42425694e-05">
                  <inertial mass="0.1879" pos="0 0 -0.001159" diaginertia="8.06247583e-05 8.06247583e-05 0.000132117188" />
                  <joint name="wrist_3_joint" class="size1" />
                  <geom mesh="wrist3_0" material="black" class="visual" pos="0 0 -0.0818" quat="0.707106781 0.707106781 0 0" />
                  <geom mesh="wrist3_1" material="linkgray" class="visual" pos="0 0 -0.0818" quat="0.707106781 0.707106781 0 0" />
                  <geom mesh="wrist3_col" class="collision" pos="0 0 -0.0818" quat="0.707106781 0.707106781 0 0" />
                  <site name="tool0" />
                  <!-- ROS first_ring_link: ring (12 mm) + printed mount (second_ring_link); hand base 24 mm out -->
                  <body name="hand_mount" gravcomp="1" quat="0.707105483 0 0 -0.70710808">
                    <!-- mount mass not in source model; placeholder estimate -->
                    <inertial pos="0 0 0.012" mass="0.15" diaginertia="8e-5 8e-5 1.2e-4" />
                    <geom type="cylinder" size="0.04 0.006" material="mount_ring" />
                    <geom class="visual" mesh="hand_mount" material="mount_black" pos="0 0 0.006" quat="0.5 0.5 0.5 0.5" />
                    <geom type="cylinder" size="0.04 0.008" pos="0 0 0.014" group="3" />
                    <site name="hand_attach" pos="0 0 0.024" />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- base is world-welded (no parent filter); forearm/wrist_2 hulls overlap ~1 mm at palm home; wrist_1/wrist_3 per SRDF -->
  <contact>
    <exclude body1="base" body2="shoulder_link" />
    <exclude body1="forearm_link" body2="wrist_2_link" />
    <exclude body1="wrist_1_link" body2="wrist_3_link" />
  </contact>

  <actuator>
    <general class="ur5" name="shoulder_pan" joint="shoulder_pan_joint" />
    <general class="ur5" name="shoulder_lift" joint="shoulder_lift_joint" />
    <general class="size3_limited" name="elbow" joint="elbow_joint" />
    <general class="size1" name="wrist_1" joint="wrist_1_joint" />
    <general class="size1" name="wrist_2" joint="wrist_2_joint" />
    <general class="size1" name="wrist_3" joint="wrist_3_joint" />
  </actuator>
</mujoco>
