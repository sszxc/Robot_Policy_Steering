<!-- Lab fixtures from ros2_ur ur_description/urdf/inc/workcell.xacro (pixi_teleop 7dc57cb), in ROS world coordinates.
     Table visual: test.stl (as-is); collision is the URDF box. -->
<mujoco model="lab_workcell">
  <compiler angle="radian" meshdir="assets" />
  <asset>
    <material name="lab_table" rgba="0.6 0.4 0.2 1" />
    <material name="lab_stand" rgba="0.35 0.35 0.37 1" />
    <material name="lab_wall" rgba="0.8 0.8 0.8 1" />
    <material name="lab_rig" rgba="0.2 0.2 0.2 1" />
    <mesh name="lab_table" file="table.stl" />
  </asset>
  <worldbody>
    <body name="workcell">
      <geom name="table_visual" type="mesh" mesh="lab_table" material="lab_table" pos="0.7 -0.315 0.01"
        contype="0" conaffinity="0" group="2" />
      <geom name="table" type="box" size="0.66 0.36 0.3" pos="0.05 -0.675 0.31" group="3"
        condim="3" friction="1 0.01 0.001" />
      <site name="table_surface_center" pos="0.05 -0.675 0.61" size="0.01" rgba="0 1 0 0.5" group="4" />
      <geom name="stand" type="box" size="0.25 0.25 0.5" pos="0 0 0.5" material="lab_stand" />
      <geom name="wall" type="box" size="1.75 0.1 1.75" pos="0 0.545 1.25" material="lab_wall" />
      <!-- ceiling camera fixture (geometry only): camera box, drop pipe, beam -->
      <geom name="camera_box" type="box" size="0.05 0.05 0.05" pos="0 -0.86 1.57" material="lab_rig" />
      <geom name="camera_pipe" type="cylinder" size="0.025 0.3" pos="0 -0.86 1.87" material="lab_rig" />
      <geom name="camera_beam" type="cylinder" size="0.025 0.615" pos="0 -0.245 2.17"
        quat="0.707106781 0.707106781 0 0" material="lab_rig" />
    </body>
  </worldbody>
</mujoco>
