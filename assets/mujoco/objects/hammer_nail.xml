<mujoco model="hammer_nail">
  <!-- Wooden block with a nail on a damped slide joint; origin at block bottom center.
       gravcomp + stiff solimpfriction stop the soft frictionloss from creeping. -->
  <default>
    <default class="nail_resist">
      <joint type="slide" axis="0 0 -1" range="0 0.04" damping="15" frictionloss="12" armature="0.05"
        solimpfriction="0.99 0.999 0.001" />
    </default>
  </default>
  <worldbody>
    <body name="nail_block">
      <geom name="nail_block" type="box" pos="0 0 0.04" size="0.05 0.05 0.04" rgba="0.62 0.47 0.3 1" />
      <body name="nail" pos="0 0 0.125" gravcomp="1">
        <joint name="nail" class="nail_resist" />
        <geom name="nail_head" type="cylinder" size="0.009 0.002" mass="0.005" solref="0.005 1"
          rgba="0.75 0.75 0.78 1" />
        <geom name="nail_shaft" type="capsule" fromto="0 0 0 0 0 -0.07" size="0.0025" mass="0.005"
          contype="0" conaffinity="0" rgba="0.75 0.75 0.78 1" />
      </body>
    </body>
  </worldbody>
</mujoco>
